# Nginx de la entrada única. Todo es el mismo origen: sin CORS, y el token nunca sale hacia otro origen.

# El registro de accesos incluye el identificador de cada petición, el mismo que recibe la API.
log_format con_peticion '$remote_addr - [$time_local] "$request" $status $body_bytes_sent $request_time peticion=$request_id';

# Protocolo con el que llegó el navegador: detrás de Cloudflare viene en X-Forwarded-Proto (cloudflared habla con
# este Nginx por HTTP); sin esa cabecera, el de esta conexión.
map $http_x_forwarded_proto $protocolo {
    default $http_x_forwarded_proto;
    '' $scheme;
}

map $http_upgrade $conexion {
    default upgrade;
    '' close;
}

server {
    listen 80;

    # Los servicios se buscan por nombre en el DNS de Docker cada vez, no solo al arrancar: si la API o Reverb se
    # recrean (cambian de IP), la entrada los sigue encontrando en vez de responder 502.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api http://api;
    set $reverb http://reverb:8080;
    server_tokens off;

    # IP real del cliente. El puerto solo se publica en 127.0.0.1, así que únicamente un proceso del propio servidor
    # (cloudflared) llega hasta aquí: se toma la IP que informa Cloudflare y se descarta cualquier X-Forwarded-For
    # que mande el cliente.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.1;
    real_ip_header CF-Connecting-IP;

    # Quien entra por HTTP a través de Cloudflare pasa a HTTPS antes de enviar nada (contraseña ni token).
    if ($http_x_forwarded_proto = "http") {
        return 301 https://$host$request_uri;
    }

    access_log /var/log/nginx/access.log con_peticion;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 1m;

    # La aplicación: cualquier ruta desconocida la resuelve el enrutador del navegador.
    location / {
        include /etc/nginx/snippets/cabeceras.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }

    # Archivos compilados: su nombre lleva un resumen del contenido, así que se guardan un año.
    location /assets/ {
        include /etc/nginx/snippets/cabeceras.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Configuración que el frontend lee al arrancar. La clave de Reverb es pública por diseño.
    location = /configuracion.json {
        include /etc/nginx/snippets/cabeceras.conf;
        add_header Cache-Control "no-store" always;
        default_type application/json;
        return 200 '{"tiempoReal":{"clave":"${REVERB_APP_KEY}"}}';
    }

    # API de Laravel. Sus respuestas traen sus propias cabeceras de seguridad.
    location /api/ {
        # Mensajes con imágenes: el mismo tope que la API.
        client_max_body_size 26m;
        proxy_pass $api;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        # Solo la IP real: la API no recibe la cadena que pudo inventar el cliente.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $protocolo;
        # El mismo identificador en el log de Nginx y en el de la API (correlación de punta a punta).
        proxy_set_header X-Request-Id $request_id;
        # Las descargas grandes (exportación) pueden tardar.
        proxy_read_timeout 120s;
    }

    # Conexión WebSocket del navegador con Reverb. Solo /app: la API de publicación de Reverb (/apps) la usa
    # Laravel por la red interna y no se expone.
    location /app/ {
        proxy_pass $reverb;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $conexion;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 3600s;
    }

    location ~ /\. {
        deny all;
    }
}
