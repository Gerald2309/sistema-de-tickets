{
  "name": "mesa-de-ayuda-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "formato": "prettier --check .",
    "formato:arreglar": "prettier --write .",
    "estilos": "stylelint \"src/**/*.{css,vue}\"",
    "tipos": "vue-tsc --noEmit -p jsconfig.json",
    "prueba": "vitest run",
    "prueba:cobertura": "vitest run --coverage",
    "prueba:recorridos": "playwright test",
    "verificar": "npm run lint && npm run formato && npm run estilos && npm run tipos && npm run prueba && npm run build"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@mdi/js": "^7.4.47",
    "@tanstack/vue-query": "^5.105.0",
    "axios": "^1.20.0",
    "laravel-echo": "^2.6.1",
    "pinia": "^4.1.0",
    "pusher-js": "^8.6.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuetify": "^2.7.3",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "msw": "^3.0.3",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true
  }
}
